"""
(Vector - Point) is a NVector (grade -1); combining two NVectors via `+`
is not an NVector for the same reason Point + Point is (the grade would leave
{NVector, Vector, Point}).
"""
x : Float[Unit[s] & Point] = 10.0
y : Float[Unit[s] & Vector] = 5.0
dv = y - x
it : Float[Unit[s] & NVector] = dv + dv
