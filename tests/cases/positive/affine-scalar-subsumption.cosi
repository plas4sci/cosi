"""
A known scalar Scalar[c] is a pure number, independent of the origin, so it
is below Vector in the subsumption order: it can be used where a Vector is
expected, and an operator that is not defined on it directly uses it as a
Vector. Being a pure number it is dimensionless, so it only stands in for a
dimensionless Vector, e.g. it can be added to a dimensionless Point (but not
to a time Point, which needs a Vector in seconds).
"""
def lerp (p, q, t) -> Float[Unit[s] & Point]:
  p : Float[Unit[s] & Point]
  q : Float[Unit[s] & Point]
  t : Float[Vector]
  return p + t * (q - p)

p : Float[Unit[s] & Point] = 10.0
q : Float[Unit[s] & Point] = 4.0
w : Float[Scalar[1/4]] = 0.25
v : Float[Vector] = w

p0 : Float[Point] = 10.0
d : Float[Scalar[2]] = 2.0
later : Float[Point] = p0 + d

it = (lerp(p, q, w), (v, later))
