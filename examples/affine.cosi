"""
Affine-space example.

A Point is an absolute position; a Vector is a displacement. Unlike
ordinary units, they don't need identical types to combine with `+`/`-`:

  Point + Vector = Point   (move a point by a displacement)
  Point - Vector = Point   (move a point backwards)
  Point - Point  = Vector  (the displacement between two points)
"""

x  : Float[Unit[s] & Point]  = 10.0
dx : Float[Unit[s] & Vector] = 5.0
y  : Float[Unit[s] & Point]  = 3.0

x_forward    : Float[Unit[s] & Point]  = x + dx
x_backward   : Float[Unit[s] & Point]  = x - dx
displacement : Float[Unit[s] & Vector] = x - y

c : Float[Unit[1] & Scalar[0.5]] = 0.5
d : Float[Unit[1] & Scalar[0.15]] = 0.15

cd : Float[Unit[1] & Scalar[0.65]] = c + d

cq : Float[Unit[s] & Scalar[0.5]] = 0.5

bad0 = cq + x

and_then : Float[Unit[s] & Affine[0.5]] = x * c

bad : Float[Unit[s*s] & Vector] = dx * dx

# it = (x_forward, (x_backward, displacement))
